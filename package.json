{
  "name": "permafrost",
  "private": true,
  "version": "0.3.3",
  "description": "Drill down through a frozen planet, haul ore back up, upgrade your rig. Shared online world.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shots": "node scripts/screenshots.mjs",
    "build:server": "node scripts/build-server.mjs",
    "server": "node scripts/build-server.mjs && node --disable-warning=ExperimentalWarning dist-server/index.mjs",
    "mp": "node scripts/mp.mjs",
    "ship": "node scripts/ship.mjs",
    "uicheck": "node scripts/ui-check.mjs",
    "cinecheck": "node scripts/cine-check.mjs",
    "soscheck": "node scripts/sos-check.mjs"
  },
  "dependencies": {
    "@fontsource/silkscreen": "5.3.0",
    "phaser": "3.90.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "playwright-core": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
